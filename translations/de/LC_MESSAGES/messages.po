#, python-format
msgid "Completed in %ss"
msgstr "Abgeschlossen in %ss"

#: octoprint_grblpcb/static/js/grblpcb.js:2034
#, python-format
msgid "Stopped at line %d"
msgstr "Gestoppt bei Zeile %d"

#: octoprint_grblpcb/static/js/grblpcb.js:2039
#, python-format
msgid "GRBL rejected line %(line)d (%(command)s): error %(code)d. The job was stopped and the machine halted, because the lines after it may depend on the rejected one."
msgstr "GRBL hat Zeile %(line)d (%(command)s) abgelehnt: Fehler %(code)d. Der Auftrag wurde gestoppt und die Maschine angehalten, weil die folgenden Zeilen von der abgelehnten abhängen können."

#: octoprint_grblpcb/static/js/grblpcb.js:2043
msgid "GRBL raised an alarm. The job was stopped. Unlock or home the machine and check the work zero before starting again."
msgstr "GRBL hat einen Alarm gemeldet. Der Auftrag wurde gestoppt. Entsperre die Maschine oder mache eine Referenzfahrt und prüfe den Werkstück-Nullpunkt, bevor du neu startest."

#: octoprint_grblpcb/static/js/grblpcb.js:2047
msgid "The connection to GRBL was lost. The job was stopped."
msgstr "Die Verbindung zu GRBL ist abgebrochen. Der Auftrag wurde gestoppt."

#: octoprint_grblpcb/static/js/grblpcb.js:2049
msgid "The job was stopped by an internal error. See the OctoPrint log."
msgstr "Der Auftrag wurde durch einen internen Fehler gestoppt. Details stehen im OctoPrint-Protokoll."

#: octoprint_grblpcb/static/js/grblpcb.js:2051
#, python-format
msgid "Failed at line %d."
msgstr "Fehlgeschlagen bei Zeile %d."

#: octoprint_grblpcb/static/js/grblpcb.js:2053
