msgid "Next:"
msgstr "Als Nächstes:"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:91
msgid "Jog"
msgstr "Tippbetrieb"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:98
msgid "Go to 0,0"
msgstr "Gehe zu 0,0"

