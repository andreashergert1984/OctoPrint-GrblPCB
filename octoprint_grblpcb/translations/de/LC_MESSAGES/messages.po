msgid "CNC Control"
msgstr "CNC-Steuerung"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:7
msgid "PCB Project"
msgstr "Platinenprojekt"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:10
msgid "Autolevel"
msgstr "Autolevel"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:14
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:670
msgid "Operations"
msgstr "Operationen"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:22
msgid "ALARM STATE"
msgstr "ALARMZUSTAND"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:24
msgid "Unlock ($X)"
msgstr "Entsperren ($X)"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:27
msgid "Home All"
msgstr "Alle Achsen referenzieren"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:37
msgid "Toggle controls panel"
msgstr "Steuerungspanel ein-/ausblenden"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:70
msgid "Tip: home first, then check the zero and run a short machine check before the first job."
msgstr "Tipp: zuerst Referenzfahrt, dann Nullpunkt prüfen und vor dem ersten Auftrag einen kurzen Maschinencheck ausführen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:76
msgid "Quick Guide"
msgstr "Kurzanleitung"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:83
msgid "1. Connect to GRBL and home the machine."
msgstr "1. Mit GRBL verbinden und Referenzfahrt ausführen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:84
msgid "2. Set X/Y/Z zero at the board origin or probe point."
msgstr "2. X/Y/Z-Nullpunkt am Platinenursprung oder Antastpunkt setzen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:85
msgid "3. Use Check to confirm the controller is idle and safe."
msgstr "3. Mit „Check“ prüfen, dass die Steuerung im Leerlauf und sicher ist."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:86
msgid "4. Start with a sample file before a real PCB."
msgstr "4. Vor der echten Platine mit einer Beispieldatei beginnen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:93
msgid "For Experienced Users"
msgstr "Für Erfahrene"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:100
msgid "Use the status bar to check state, feed, spindle, and position at a glance."
msgstr "Die Statusleiste zeigt Zustand, Vorschub, Spindel und Position auf einen Blick."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:101
msgid "Run Probe or autolevel only after the setup is mechanically stable."
msgstr "Antasten oder Autolevel erst starten, wenn der Aufbau mechanisch stabil ist."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:102
msgid "Preview routing and drilling separately before combining them."
msgstr "Fräsen und Bohren erst getrennt in der Vorschau prüfen, bevor sie kombiniert werden."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:103
msgid "Tune feed, spindle, and probe settings on scrap material before production runs."
msgstr "Vorschub, Spindel und Antasten auf Restmaterial abstimmen, bevor echte Platinen gefräst werden."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:112
msgid "Home the machine first."
msgstr "Zuerst Referenzfahrt ausführen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:113
msgid "Set zero on the board."
msgstr "Nullpunkt auf der Platine setzen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:114
msgid "Run Check before milling."
msgstr "Vor dem Fräsen den Check ausführen."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:125
msgid "Jog"
msgstr "Tippbetrieb"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:132
msgid "Go to 0,0"
msgstr "Gehe zu 0,0"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:151
msgid "Feed:"
msgstr "Vorschub:"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:154
msgid "Tip: use 10 mm or 1 mm jogs when confirming direction and travel. Reserve 0.1 mm for fine adjustment."
msgstr "Tipp: Richtung und Verfahrweg mit 10 mm oder 1 mm prüfen. 0,1 mm nur für die Feineinstellung."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:157
msgid "If an axis moves in the wrong direction, stop and correct the machine configuration before continuing."
msgstr "Fährt eine Achse in die falsche Richtung, anhalten und die Maschinenkonfiguration korrigieren, bevor es weitergeht."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:163
msgid "Machine"
msgstr "Maschine"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:166
msgid "Home"
msgstr "Referenzfahrt"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:169
msgid "Unlock"
msgstr "Entsperren"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:172
msgid "RST"
msgstr "RST"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:181
msgid "Check"
msgstr "Check"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:185
msgid "Before milling:"
msgstr "Vor dem Fräsen:"

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:185
msgid "Home → unlock if needed → set zero → run Check. If the controller is not Idle, do not start the job."
msgstr "Referenzfahrt → bei Bedarf entsperren → Nullpunkt setzen → Check ausführen. Ist die Steuerung nicht im Leerlauf, den Auftrag nicht starten."

#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:188
msgid "For repeatability, verify one axis at a time and compare the travel with a ruler or dial indicator."
msgstr "Für die Wiederholgenauigkeit jede Achse einzeln prüfen und den Verfahrweg mit Lineal oder Messuhr vergleichen."

