#: octoprint_grblpcb/__init__.py:344
msgid "GRBL CNC Connection"
msgstr "GRBL-CNC-Verbindung"

#: octoprint_grblpcb/__init__.py:352
msgid "GRBL CNC / PCB Milling"
msgstr "GRBL-CNC / Platinenfräsen"

#: octoprint_grblpcb/__init__.py:560 octoprint_grblpcb/__init__.py:1095
msgid "You do not have the permission for this action."
msgstr "Für diese Aktion fehlt die Berechtigung."

#: octoprint_grblpcb/__init__.py:572
msgid "Not possible while a job is running. Wait for a tool change or pause, or stop the job."
msgstr "Nicht möglich, solange ein Auftrag läuft. Auf einen Werkzeugwechsel oder eine Pause warten oder den Auftrag stoppen."

#: octoprint_grblpcb/__init__.py:586
msgid "Unknown command"
msgstr "Unbekannter Befehl"

#: octoprint_grblpcb/__init__.py:601 octoprint_grblpcb/__init__.py:830
#: octoprint_grblpcb/__init__.py:2064 octoprint_grblpcb/__init__.py:2630
#: octoprint_grblpcb/__init__.py:3113 octoprint_grblpcb/__init__.py:3182
#: octoprint_grblpcb/__init__.py:3193 octoprint_grblpcb/__init__.py:3204
msgid "Not connected to GRBL"
msgstr "Nicht mit GRBL verbunden"

#: octoprint_grblpcb/__init__.py:618
msgid "Not possible while probing is running. Wait until it is done or stop it."
msgstr "Nicht möglich, solange das Antasten läuft. Warten, bis es fertig ist, oder es stoppen."

#: octoprint_grblpcb/__init__.py:629
msgid "The machine is still being stopped. Wait a moment, then try again."
msgstr "Die Maschine wird noch gestoppt. Einen Moment warten, dann erneut versuchen."

#: octoprint_grblpcb/__init__.py:634
#, python-format
msgid "GRBL is busy (state: %(state)s). Wait until the machine is idle, then try again."
msgstr "GRBL ist beschäftigt (Zustand: %(state)s). Warten, bis die Maschine bereit ist, dann erneut versuchen."

#: octoprint_grblpcb/__init__.py:644
msgid "GRBL is in alarm. Unlock it (or home), check the position and the zero, then try again."
msgstr "GRBL ist im Alarm. Erst entsperren (oder Referenzfahrt), Position und Nullpunkt prüfen, dann erneut versuchen."

#: octoprint_grblpcb/__init__.py:662 octoprint_grblpcb/__init__.py:1943
#, python-format
msgid "Invalid layer type: %(value)s"
msgstr "Ungültiger Lagentyp: %(value)s"

#: octoprint_grblpcb/__init__.py:682
#, python-format
msgid "Invalid probe axis: %(value)s"
msgstr "Ungültige Antastachse: %(value)s"

#: octoprint_grblpcb/__init__.py:759
#, python-format
msgid "Invalid WCS: %(value)s"
msgstr "Ungültiges Werkstück-Koordinatensystem: %(value)s"

#: octoprint_grblpcb/__init__.py:770
#, python-format
msgid "Invalid axis: %(value)s"
msgstr "Ungültige Achse: %(value)s"

#: octoprint_grblpcb/__init__.py:830
msgid "Connected to GRBL"
msgstr "Mit GRBL verbunden"

#: octoprint_grblpcb/__init__.py:835
msgid "Connection is required before machine checks can run"
msgstr "Für den Maschinencheck ist eine Verbindung nötig"

#: octoprint_grblpcb/__init__.py:837
#, python-format
msgid "GRBL is in ALARM state (%(state)s)"
msgstr "GRBL ist im Alarm (%(state)s)"

#: octoprint_grblpcb/__init__.py:839
msgid "GRBL is idle and ready"
msgstr "GRBL ist im Leerlauf und bereit"

#: octoprint_grblpcb/__init__.py:841
#, python-format
msgid "GRBL is busy or paused (%(state)s)"
msgstr "GRBL ist beschäftigt oder pausiert (%(state)s)"

#: octoprint_grblpcb/__init__.py:846
msgid "No active stream"
msgstr "Kein laufender Auftrag"

#: octoprint_grblpcb/__init__.py:846
msgid "A G-code stream is active"
msgstr "Ein G-Code-Auftrag läuft"

#: octoprint_grblpcb/__init__.py:852
msgid "No active probe"
msgstr "Es läuft kein Antasten"

#: octoprint_grblpcb/__init__.py:852
msgid "A probe run is active"
msgstr "Das Antasten läuft"

#: octoprint_grblpcb/__init__.py:865
msgid "This check verifies controller state and workflow safety."
msgstr "Dieser Check prüft den Zustand der Steuerung und die Ablaufsicherheit."

#: octoprint_grblpcb/__init__.py:866
msgid "Step loss, backlash, and absolute accuracy require external measurement such as a dial indicator, gauge block, or probe pad."
msgstr "Schrittverlust, Umkehrspiel und absolute Genauigkeit lassen sich nur mit externer Messung prüfen, etwa mit Messuhr, Endmaß oder Antastplatte."

#: octoprint_grblpcb/__init__.py:886
msgid "Speed must be a number"
msgstr "Die Drehzahl muss eine Zahl sein"

#: octoprint_grblpcb/__init__.py:888
#, python-format
msgid "Speed out of range (0-30000): %(value)s"
msgstr "Drehzahl außerhalb des Bereichs (0 bis 30000): %(value)s"

#: octoprint_grblpcb/__init__.py:916
#, python-format
msgid "Invalid jog axis: %(value)s"
msgstr "Ungültige Achse zum Tippen: %(value)s"

#: octoprint_grblpcb/__init__.py:920
msgid "Distance must be a number"
msgstr "Der Weg muss eine Zahl sein"

#: octoprint_grblpcb/__init__.py:922
#, python-format
msgid "Jog distance too large: %(value)s"
msgstr "Tippweg zu groß: %(value)s"

#: octoprint_grblpcb/__init__.py:926
msgid "Feed must be a number"
msgstr "Der Vorschub muss eine Zahl sein"

#: octoprint_grblpcb/__init__.py:928
#, python-format
msgid "Feed out of range (1-10000): %(value)s"
msgstr "Vorschub außerhalb des Bereichs (1 bis 10000): %(value)s"

#: octoprint_grblpcb/__init__.py:983 octoprint_grblpcb/__init__.py:1045
#: octoprint_grblpcb/__init__.py:1674 octoprint_grblpcb/__init__.py:1761
