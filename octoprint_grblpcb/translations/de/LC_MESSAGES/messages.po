msgid "No project"
msgstr "Kein Projekt"

#: octoprint_grblpcb/__init__.py:1050
#, python-format
msgid "Invalid board side: %(value)s"
msgstr "Ungültige Platinenseite: %(value)s"

#: octoprint_grblpcb/__init__.py:1056
#, python-format
msgid "Invalid flip axis: %(value)s"
msgstr "Ungültige Spiegelachse: %(value)s"

#: octoprint_grblpcb/__init__.py:1263
#, python-format
msgid "File not found: %(value)s"
msgstr "Datei nicht gefunden: %(value)s"

#: octoprint_grblpcb/__init__.py:1279 octoprint_grblpcb/__init__.py:1349
msgid "No project_id provided"
msgstr "Keine Projekt-ID angegeben"

#: octoprint_grblpcb/__init__.py:1283
msgid "Invalid project ID"
msgstr "Ungültige Projekt-ID"

#: octoprint_grblpcb/__init__.py:1286 octoprint_grblpcb/__init__.py:1361
#, python-format
msgid "Project not found: %(value)s"
msgstr "Projekt nicht gefunden: %(value)s"

#: octoprint_grblpcb/__init__.py:1541 octoprint_grblpcb/__init__.py:1815
msgid "No project loaded"
msgstr "Kein Projekt geladen"

#: octoprint_grblpcb/__init__.py:1680
#, python-format
msgid "No geometry for %(value)s"
msgstr "Keine Geometrie für %(value)s"

#: octoprint_grblpcb/__init__.py:1818
msgid "Drill file contains no holes (0 tools, 0 holes)"
msgstr "Die Bohrdatei enthält keine Bohrungen (0 Werkzeuge, 0 Bohrungen)"

#: octoprint_grblpcb/__init__.py:1887 octoprint_grblpcb/__init__.py:1908
msgid "No outline layer and no board dimensions"
msgstr "Keine Umrisslage und keine Platinenmaße"

#: octoprint_grblpcb/__init__.py:1952
msgid "No board dimensions available"
msgstr "Keine Platinenmaße vorhanden"

#: octoprint_grblpcb/__init__.py:1975
msgid "Generated empty G-code: nothing to expose"
msgstr "Leerer G-Code erzeugt: nichts zu belichten"

#: octoprint_grblpcb/__init__.py:2023
msgid "The grid needs a whole number of 2 to 20 points in X and Y."
msgstr "Das Raster braucht in X und Y je eine ganze Zahl von 2 bis 20 Punkten."

#: octoprint_grblpcb/__init__.py:2031
msgid "The margin must be a number from 0 to 50 mm."
msgstr "Der Rand muss eine Zahl von 0 bis 50 mm sein."

#: octoprint_grblpcb/__init__.py:2060
msgid "No height map configured"
msgstr "Keine Höhenkarte eingerichtet"

#: octoprint_grblpcb/__init__.py:2067 octoprint_grblpcb/__init__.py:2633
msgid "Probing already in progress"
msgstr "Das Antasten läuft bereits"

#: octoprint_grblpcb/__init__.py:2070 octoprint_grblpcb/__init__.py:2636
msgid "Cannot start probing while streaming is active"
msgstr "Antasten ist nicht möglich, solange ein Auftrag läuft"

#: octoprint_grblpcb/__init__.py:2099
msgid "Probing started"
msgstr "Antasten gestartet"

#: octoprint_grblpcb/__init__.py:2452
msgid "Height map not complete"
msgstr "Höhenkarte nicht vollständig"

#: octoprint_grblpcb/__init__.py:2456 octoprint_grblpcb/__init__.py:2497
#: octoprint_grblpcb/__init__.py:2997 octoprint_grblpcb/__init__.py:3051
#: octoprint_grblpcb/__init__.py:3073 octoprint_grblpcb/__init__.py:3124
msgid "Invalid operation index"
msgstr "Ungültige Operation"

#: octoprint_grblpcb/__init__.py:2460
msgid "No G-code to correct"
msgstr "Kein G-Code zum Korrigieren"

#: octoprint_grblpcb/__init__.py:2501
msgid "This operation is already the back-side version"
msgstr "Diese Operation ist bereits die Rückseite"

#: octoprint_grblpcb/__init__.py:2506
msgid "Only drilling and the outline are mirrored for the back side. Bottom copper is generated for the back side directly."
msgstr "Für die Rückseite werden nur Bohren und Umriss gespiegelt. Das Kupfer unten wird direkt für die Rückseite erzeugt."

#: octoprint_grblpcb/__init__.py:2510
msgid "Generate this operation again, then it can be mirrored for the back side."
msgstr "Diese Operation bitte neu erzeugen, dann lässt sie sich für die Rückseite spiegeln."

#: octoprint_grblpcb/__init__.py:2534 octoprint_grblpcb/__init__.py:2579
msgid "Need at least 2 alignment holes"
msgstr "Mindestens 2 Ausrichtungslöcher erforderlich"

#: octoprint_grblpcb/__init__.py:2589
#, python-format
msgid "Fewer than two drill holes are at least %(d)s mm wide. The probe may not fit into the selected holes; add larger holes for alignment if probing fails."
msgstr "Weniger als zwei Bohrungen sind mindestens %(d)s mm breit. Der Taster passt eventuell nicht in die gewählten Löcher; schlägt das Antasten fehl, größere Löcher für die Ausrichtung vorsehen."

#: octoprint_grblpcb/__init__.py:2626
msgid "No alignment holes set"
msgstr "Keine Ausrichtungslöcher festgelegt"

#: octoprint_grblpcb/__init__.py:2654
msgid "Alignment probing started"
msgstr "Antasten der Ausrichtungslöcher gestartet"

#: octoprint_grblpcb/__init__.py:2959
#, python-format
msgid "Need at least 2 probed holes, have %(value)s"
msgstr "Mindestens 2 abgetastete Löcher erforderlich, vorhanden: %(value)s"

#: octoprint_grblpcb/__init__.py:2968
#, python-format
msgid "Transform computation failed: %(value)s"
msgstr "Berechnung der Ausrichtung fehlgeschlagen: %(value)s"

#: octoprint_grblpcb/__init__.py:2978
#, python-format
msgid "Alignment: rotation %(angle).3f°, offset (%(tx).4f, %(ty).4f) mm, RMS error %(rms).4f mm"
msgstr "Ausrichtung: Drehung %(angle).3f°, Versatz (%(tx).4f, %(ty).4f) mm, RMS-Fehler %(rms).4f mm"

#: octoprint_grblpcb/__init__.py:2993
msgid "No alignment transform computed"
msgstr "Keine Ausrichtung berechnet"

#: octoprint_grblpcb/__init__.py:3002
msgid "No G-code to transform"
msgstr "Kein G-Code zum Umrechnen"

#: octoprint_grblpcb/__init__.py:3019
#, python-format
msgid "Alignment applied: %(angle).3f° rotation, (%(tx).4f, %(ty).4f) mm offset"
msgstr "Ausrichtung angewendet: %(angle).3f° Drehung, Versatz (%(tx).4f, %(ty).4f) mm"

#: octoprint_grblpcb/__init__.py:3056
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:732
msgid "No G-code"
msgstr "Kein G-Code"

#: octoprint_grblpcb/__init__.py:3094
msgid "Invalid order - must be permutation of indices"
msgstr "Ungültige Reihenfolge: Jede Operation muss genau einmal vorkommen"

#: octoprint_grblpcb/__init__.py:3116
msgid "Cannot start streaming while probing is active"
msgstr "Senden ist nicht möglich, solange das Antasten läuft"

#: octoprint_grblpcb/__init__.py:3129
msgid "No G-code to execute"
msgstr "Kein G-Code zum Ausführen"

#: octoprint_grblpcb/__init__.py:3136
msgid "This bottom-layer operation is not mirrored. Generate it again (it is mirrored automatically)."
msgstr "Diese Operation der Unterseite ist nicht gespiegelt. Sie neu erzeugen (sie wird dann automatisch gespiegelt)."

#: octoprint_grblpcb/__init__.py:3168
msgid "Failed to start streaming"
msgstr "Senden konnte nicht gestartet werden"

#: octoprint_grblpcb/__init__.py:3185
msgid "Execution stopped"
msgstr "Ausführung gestoppt"

#: octoprint_grblpcb/__init__.py:3196
msgid "Tool change confirmed"
msgstr "Werkzeugwechsel bestätigt"

#: octoprint_grblpcb/__init__.py:3213
#, python-format
msgid "Invalid override type: %(value)s"
msgstr "Ungültige Übersteuerung: %(value)s"

#: octoprint_grblpcb/__init__.py:3215
#, python-format
msgid "Invalid action: %(value)s"
msgstr "Ungültige Aktion: %(value)s"

#: octoprint_grblpcb/__init__.py:3219
msgid "Failed to send override"
msgstr "Übersteuerung konnte nicht gesendet werden"

#: octoprint_grblpcb/connector.py:260
#, python-format
msgid "No GRBL status report on %(port)s at %(baudrate)s baud. Check the port and the baud rate."
msgstr "Kein GRBL-Statusbericht an %(port)s mit %(baudrate)s Baud. Den Anschluss und die Baudrate prüfen."

#: octoprint_grblpcb/connector.py:279
#: octoprint_grblpcb/static/js/grblpcb.js:2141
msgid "Connection to GRBL lost"
msgstr "Verbindung zu GRBL verloren"

#: octoprint_grblpcb/connector.py:281
msgid "The position and the work zero may be lost. Reconnect, home or check the zero before milling."
msgstr "Die Position und der Werkstück-Nullpunkt sind möglicherweise verloren. Neu verbinden, dann Referenzfahrt machen oder den Nullpunkt prüfen, bevor gefräst wird."

#: octoprint_grblpcb/connector.py:452
msgid "Alarm (GRBL)"
msgstr "Alarm (GRBL)"

#: octoprint_grblpcb/connector.py:488
msgid "not sent: probing is running. Wait until it is done or stop it."
msgstr "nicht gesendet: Das Antasten läuft. Warten, bis es fertig ist, oder es stoppen."

#: octoprint_grblpcb/connector.py:490
msgid "not sent: a job is running. Wait for a pause or stop the job."
msgstr "nicht gesendet: Ein Auftrag läuft. Auf eine Pause warten oder den Auftrag stoppen."

#: octoprint_grblpcb/connector.py:681
msgid "not sent: the machine is still being stopped."
msgstr "nicht gesendet: Die Maschine wird noch gestoppt."

#: octoprint_grblpcb/connector.py:1039
#: octoprint_grblpcb/static/js/grblpcb.js:2269
msgid "GRBL was reset during the job. Check the position and the zero before milling again."
msgstr "GRBL wurde während des Auftrags zurückgesetzt. Vor dem nächsten Fräsen Position und Nullpunkt prüfen."

#: octoprint_grblpcb/connector.py:1197
msgid "GRBL stopped answering, the serial port is still open."
msgstr "GRBL antwortet nicht mehr, der serielle Port ist aber noch offen."

#: octoprint_grblpcb/static/js/grblpcb.js:111
msgid "Untitled PCB"
msgstr "Unbenannte Platine"

#: octoprint_grblpcb/static/js/grblpcb.js:137
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:212
