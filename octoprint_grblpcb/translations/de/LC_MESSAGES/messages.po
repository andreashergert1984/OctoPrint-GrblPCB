msgstr "V-Stichel, Spitze %(tip)s mm, %(angle)s°"

#: octoprint_grblpcb/static/js/grblpcb.js:1823
#, python-format
msgid "End mill %(d)s mm"
msgstr "Schaftfräser %(d)s mm"

#: octoprint_grblpcb/static/js/grblpcb.js:1825
msgid "Drills: the job pauses before each drill size"
msgstr "Bohrer: Der Auftrag hält vor jeder Bohrergröße an"

#: octoprint_grblpcb/static/js/grblpcb.js:1827
msgid "UV LED instead of the spindle"
msgstr "UV-LED statt Spindel"

#: octoprint_grblpcb/static/js/grblpcb.js:1835
msgid "No G-code generated yet"
msgstr "Noch kein G-Code erzeugt"

#: octoprint_grblpcb/static/js/grblpcb.js:1836
msgid "Outdated: generate this operation again"
msgstr "Veraltet: diese Operation neu erzeugen"

#: octoprint_grblpcb/static/js/grblpcb.js:1837
msgid "Not connected to a GRBL machine"
msgstr "Nicht mit einer GRBL-Maschine verbunden"

#: octoprint_grblpcb/static/js/grblpcb.js:1839
msgid "GRBL is in alarm: unlock or home first"
msgstr "GRBL ist im Alarm: zuerst entsperren oder referenzieren"

#: octoprint_grblpcb/static/js/grblpcb.js:1843
msgid "Send this operation to the machine"
msgstr "Diese Operation an die Maschine senden"

#: octoprint_grblpcb/static/js/grblpcb.js:1847
