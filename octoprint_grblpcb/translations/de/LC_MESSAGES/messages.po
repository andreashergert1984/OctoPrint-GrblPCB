#: octoprint_grblpcb/static/js/grblpcb.js:343
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:4
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:460
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:906
msgid "Board"
msgstr "Platine"

#: octoprint_grblpcb/static/js/grblpcb.js:344
msgid "Import Gerber and drill files, then generate the toolpaths."
msgstr "Gerber- und Bohrdateien importieren, dann die Fräsbahnen erzeugen."

#: octoprint_grblpcb/static/js/grblpcb.js:345
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:7
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:61
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:138
msgid "Machine"
msgstr "Maschine"

#: octoprint_grblpcb/static/js/grblpcb.js:346
msgid "Connect, home, move to the board corner, zero X/Y, probe and zero Z."
msgstr "Verbinden, Referenzfahrt, zur Platinenecke fahren, X/Y nullen, Z antasten und nullen."

#: octoprint_grblpcb/static/js/grblpcb.js:347
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:10
msgid "Autolevel"
msgstr "Autolevel"

#: octoprint_grblpcb/static/js/grblpcb.js:348
msgid "Optional: probe the board surface and apply the height map to the toolpaths."
msgstr "Optional: Platinenoberfläche antasten und die Höhenkarte auf die Fräsbahnen anwenden."

#: octoprint_grblpcb/static/js/grblpcb.js:349
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:13
msgid "Milling"
msgstr "Fräsen"

#: octoprint_grblpcb/static/js/grblpcb.js:350
msgid "Send the operations to the machine one after another."
msgstr "Die Operationen nacheinander an die Maschine senden."

#: octoprint_grblpcb/static/js/grblpcb.js:362
msgid "Create a project in the Board tab and import the Gerber and drill files."
msgstr "Im Reiter „Platine“ ein Projekt anlegen und die Gerber- und Bohrdateien importieren."

#: octoprint_grblpcb/static/js/grblpcb.js:365
msgid "Generate the toolpaths in the Board tab (isolation, drilling, outline)."
msgstr "Im Reiter „Platine“ die Fräsbahnen erzeugen (Isolation, Bohren, Umriss)."

#: octoprint_grblpcb/static/js/grblpcb.js:368
msgid "Connect the machine on the left: connection type 'GRBL CNC Connection'."
msgstr "Links die Maschine verbinden: Verbindungstyp „GRBL CNC Connection“."

#: octoprint_grblpcb/static/js/grblpcb.js:371
msgid "Machine tab: home, move to the board corner, zero X/Y, then probe and zero Z."
msgstr "Reiter „Maschine“: Referenzfahrt, zur Platinenecke fahren, X/Y nullen, dann Z antasten und nullen."

#: octoprint_grblpcb/static/js/grblpcb.js:376
msgid "Milling tab: send the operations in order. Autolevel before is optional."
msgstr "Reiter „Fräsen“: die Operationen der Reihe nach senden. Autolevel vorher ist optional."

#: octoprint_grblpcb/static/js/grblpcb.js:381
#, python-format
msgid "X %(x)s, Y %(y)s, ⌀ %(d)s mm"
msgstr "X %(x)s, Y %(y)s, ⌀ %(d)s mm"

#: octoprint_grblpcb/static/js/grblpcb.js:387
#, python-format
msgid "Hole %(n)d: not probed yet"
msgstr "Loch %(n)d: noch nicht angetastet"

#: octoprint_grblpcb/static/js/grblpcb.js:390
#, python-format
msgid "Hole %(n)d: off by %(dev)s mm"
msgstr "Loch %(n)d: Abweichung %(dev)s mm"

#: octoprint_grblpcb/static/js/grblpcb.js:454
#, python-format
