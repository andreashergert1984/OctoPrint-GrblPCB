msgstr "Die Messwerte und die Ausrichtung werden verworfen, ebenso der daraus erzeugte ausgerichtete und höhenkorrigierte G-Code. Die gewählten Löcher bleiben."

#: octoprint_grblpcb/static/js/grblpcb.js:1743
#: octoprint_grblpcb/templates/grblpcb_tab.jinja2:870
msgid "Clear"
msgstr "Löschen"

#: octoprint_grblpcb/static/js/grblpcb.js:1751
msgid "Measurements cleared. The alignment holes stay selected; probe them again."
msgstr "Messwerte gelöscht. Die Ausrichtungslöcher bleiben gewählt; sie erneut antasten."

#: octoprint_grblpcb/static/js/grblpcb.js:1762
msgid "Delete operation"
msgstr "Operation löschen"

#: octoprint_grblpcb/static/js/grblpcb.js:1763
msgid "Delete this operation?"
msgstr "Diese Operation löschen?"

#: octoprint_grblpcb/static/js/grblpcb.js:1775
msgid "Operation deleted"
msgstr "Operation gelöscht"

