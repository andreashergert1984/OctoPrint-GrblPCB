<!-- Sub-Tab Navigation -->
    <ul class="nav nav-tabs">
        <li data-bind="css: { active: activeSubTab() === 'pcb' }">
            <a href="#" data-bind="click: function(data, event) { $root.switchTab('pcb'); event.preventDefault(); event.stopPropagation(); return false; }">{{ _("Board") }}</a>
        </li>
        <li data-bind="css: { active: activeSubTab() === 'cnc' }">
            <a href="#" data-bind="click: function(data, event) { $root.switchTab('cnc'); event.preventDefault(); event.stopPropagation(); return false; }">{{ _("Machine") }}</a>
        </li>
        <li data-bind="css: { active: activeSubTab() === 'autolevel' }">
            <a href="#" data-bind="click: function(data, event) { $root.switchTab('autolevel'); event.preventDefault(); event.stopPropagation(); return false; }">{{ _("Autolevel") }}</a>
        </li>
        <li data-bind="css: { active: activeSubTab() === 'operations' }">
            <a href="#" data-bind="click: function(data, event) { $root.switchTab('operations'); event.preventDefault(); event.stopPropagation(); return false; }">{{ _("Milling") }}
                <span class="badge" data-bind="text: projectOperations().length, visible: projectOperations().length > 0"></span></a>
        </li>
    </ul>

    <!-- Alarm Warning (always visible, overlaid) -->
    <div class="grblpcb-alarm-warning" data-bind="visible: isAlarm">
        <strong>⚠️ {{ _("ALARM STATE") }}</strong>
        <button class="btn btn-warning btn-small" data-bind="click: unlock, enable: manualAllowed">
            <i class="fas fa-unlock"></i> {{ _("Unlock ($X)") }}
        </button>
        <button class="btn btn-primary btn-small" data-bind="click: homeAll, enable: manualAllowed">
            <i class="fas fa-home"></i> {{ _("Home All") }}
        </button>
    </div>

    <!-- ================================================================== -->
    <!-- Persistent Workspace Layout (always visible)                       -->
    <!-- ================================================================== -->
    <div class="grblpcb-workspace-layout">
        <!-- Control panel next to the canvas -->
        <div class="grblpcb-workspace-sidebar" data-bind="css: { collapsed: !workspaceSidebarOpen() }">

            <!-- ========================================================== -->
            <!-- Compact Status Bar (always visible)                        -->
            <!-- ========================================================== -->
            <div class="grblpcb-compact-section grblpcb-status-compact">
                <!-- ko if: isConnected -->
                <div class="grblpcb-status-row">
                    <span class="grblpcb-state-badge" data-bind="text: grblStateLabel, css: stateClass"></span>
                    <span class="grblpcb-status-feeds">
                        F<span data-bind="text: feedRate"></span>
                        S<span data-bind="text: spindleSpeed"></span>
                    </span>
                </div>
                <table class="grblpcb-pos-mini">
                    <tr>
                        <td class="grblpcb-pos-label">{{ _("Work") }}</td>
                        <td data-bind="text: workPosX"></td>
                        <td data-bind="text: workPosY"></td>
                        <td data-bind="text: workPosZ"></td>
                    </tr>
                    <tr>
                        <td class="grblpcb-pos-label">{{ _("Machine") }}</td>
                        <td data-bind="text: machinePosX"></td>
                        <td data-bind="text: machinePosY"></td>
                        <td data-bind="text: machinePosZ"></td>
                    </tr>
                </table>
                <!-- /ko -->
                <!-- ko ifnot: isConnected -->
                <div class="grblpcb-status-row">
                    <span class="grblpcb-state-badge text-muted">{{ _("Not connected") }}</span>
                </div>
                <div class="grblpcb-connect-hint">{{ _("To connect: in the Connection panel choose the connection type \"GRBL CNC Connection\" and the port of the mill, then click Connect. The type \"Serial Connection\" is for 3D printers and does not work with GRBL.") }}</div>
                <!-- /ko -->
            </div>

            <!-- Workflow: where am I, what comes next -->
            <div class="grblpcb-compact-section grblpcb-workflow">
                <ol class="grblpcb-steps" data-bind="foreach: workflowSteps">
                    <li data-bind="css: { done: done, current: current, optional: optional },
                                   click: function() { $parent.switchTab(tab); },
                                   attr: { title: hint }">
                        <i class="fas" data-bind="css: { 'fa-check-circle': done, 'fa-circle': !done }"></i>
                        <span data-bind="text: label"></span>
                    </li>
                </ol>
                <div class="grblpcb-next-step" data-bind="visible: nextStepText">
                    <strong>{{ _("Next:") }}</strong> <span data-bind="text: nextStepText"></span>
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- CNC Control Tab Content                                    -->
            <!-- ========================================================== -->
            <div data-bind="visible: activeSubTab() === 'cnc'">
                <!-- Jog Control -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-arrows-alt"></i> {{ _("Jog") }}</h4>
                    <div class="grblpcb-jog-layout">
                        <div class="grblpcb-jog-grid-compact">
                            <div></div>
                            <button class="btn btn-small" data-bind="click: jogYPlus, enable: canJog">Y+</button>
                            <div></div>
                            <button class="btn btn-small" data-bind="click: jogXMinus, enable: canJog">X-</button>
                            <button class="btn btn-small btn-default" data-bind="click: gotoZero, enable: manualIdle" title="{{ _('Go to 0,0') }}">⊙</button>
                            <button class="btn btn-small" data-bind="click: jogXPlus, enable: canJog">X+</button>
                            <div></div>
                            <button class="btn btn-small" data-bind="click: jogYMinus, enable: canJog">Y-</button>
                            <div></div>
                        </div>
                        <div class="grblpcb-jog-z-col">
                            <button class="btn btn-small" data-bind="click: jogZPlus, enable: canJog">Z+</button>
                            <button class="btn btn-small" data-bind="click: jogZMinus, enable: canJog">Z-</button>
                        </div>
                    </div>
                    <div class="grblpcb-step-presets">
                        <button class="btn btn-mini" data-bind="click: function() { setJogDistance(0.01); }, css: { active: jogDistance() == 0.01 }">0.01</button>
                        <button class="btn btn-mini" data-bind="click: function() { setJogDistance(0.1); }, css: { active: jogDistance() == 0.1 }">0.1</button>
                        <button class="btn btn-mini" data-bind="click: function() { setJogDistance(1); }, css: { active: jogDistance() == 1 }">1</button>
                        <button class="btn btn-mini" data-bind="click: function() { setJogDistance(10); }, css: { active: jogDistance() == 10 }">10</button>
                        <button class="btn btn-mini" data-bind="click: function() { setJogDistance(50); }, css: { active: jogDistance() == 50 }">50</button>
                    </div>
                    <div class="grblpcb-mt-4">
                        <label class="grblpcb-text-base">{{ _("Feed:") }} <input type="number" class="input-mini grblpcb-w-50" data-bind="value: jogFeed"> mm/min</label>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Tip: use 10 mm or 1 mm jogs when confirming direction and travel. Reserve 0.1 mm for fine adjustment.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("If an axis moves in the wrong direction, stop and correct the machine configuration before continuing.") }}
                    </div>
                </div>

                <!-- Machine Control -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-cog"></i> {{ _("Machine") }}</h4>
                    <div class="grblpcb-btn-wrap">
                        <button class="btn btn-small btn-primary" data-bind="click: homeAll, enable: manualIdle">
                            <i class="fas fa-home"></i> {{ _("Home") }}
                        </button>
                        <button class="btn btn-small btn-warning" data-bind="click: unlock, enable: manualAllowed">
                            <i class="fas fa-unlock"></i> {{ _("Unlock") }}
                        </button>
                        <button class="btn btn-small" data-bind="click: runMachineCheck, enable: isConnected"
                                title="{{ _('Check that the controller is idle and nothing is running') }}">
                            <i class="fas fa-stethoscope"></i> {{ _("Check") }}
                        </button>
                    </div>
                    <div class="grblpcb-btn-wrap grblpcb-mt-4">
                        <button class="btn btn-small" data-bind="click: feedHold, enable: isConnected" title="{{ _('Feed hold: stop the motion, can be resumed') }}">
                            <i class="fas fa-pause"></i> {{ _("Hold") }}
                        </button>
                        <button class="btn btn-small" data-bind="click: resume, enable: isConnected" title="{{ _('Resume after a feed hold') }}">
                            <i class="fas fa-play"></i> {{ _("Resume") }}
                        </button>
                        <button class="btn btn-small btn-danger" data-bind="click: softReset, enable: isConnected"
                                title="{{ _('Soft reset (Ctrl-X): stops everything at once; in motion the position may be lost') }}">
                            <i class="fas fa-stop"></i> {{ _("Reset") }}
                        </button>
                    </div>
                    <div class="grblpcb-guide-inline" data-bind="visible: showHelpNotes">
                        <strong>{{ _("Before milling:") }}</strong> {{ _("Home → unlock if needed → set zero → run Check. If the controller is not Idle, do not start the job.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("For repeatability, verify one axis at a time and compare the travel with a ruler or dial indicator.") }}
                    </div>
                    <div class="grblpcb-mt-4" data-bind="visible: machineCheckStatus">
                        <strong data-bind="text: machineCheckStatus"></strong>
                        <ul class="grblpcb-mb-0" data-bind="foreach: machineCheckChecks">
                            <li data-bind="css: { 'text-success': ok && severity === 'success', 'text-warning': !ok && severity === 'warning', 'text-error': !ok && severity === 'error' }">
                                <span data-bind="text: message"></span>
                            </li>
                        </ul>
                        <div class="grblpcb-word-break grblpcb-mt-4" data-bind="visible: machineCheckLimitations().length > 0">
                            <small data-bind="foreach: machineCheckLimitations">
                                <div data-bind="text: $data"></div>
                            </small>
                        </div>
                    </div>
                </div>

                <!-- WCS -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-crosshairs"></i> {{ _("Work Coords") }}</h4>
                    <div class="grblpcb-btn-wrap" title="{{ _('Selected work coordinate system, e.g. G54-G59. This tells GRBL where your zero point lives in the machine coordinate system.') }}">
                        <!-- ko foreach: wcsOptions -->
                        <button class="btn btn-mini" data-bind="text: $data, click: function() { $parent.setWCS($data); }, enable: $parent.manualAllowed, css: { active: $parent.currentWCS() === $data }" title="{{ _('Current work coordinate system:') }} {{ _('G54-G59') }}"></button>
                        <!-- /ko -->
                    </div>
                    <div class="grblpcb-btn-wrap grblpcb-mt-4">
                        <button class="btn btn-mini" data-bind="click: zeroX, enable: manualIdle" title="{{ _('Set current X position as 0 in the active work coordinate system.') }}">0X</button>
                        <button class="btn btn-mini" data-bind="click: zeroY, enable: manualIdle" title="{{ _('Set current Y position as 0 in the active work coordinate system.') }}">0Y</button>
                        <button class="btn btn-mini" data-bind="click: zeroZ, enable: manualIdle" title="{{ _('Set current Z position as 0 in the active work coordinate system.') }}">0Z</button>
                        <button class="btn btn-mini btn-primary" data-bind="click: zeroAll, enable: manualIdle" title="{{ _('Set X, Y and Z to zero in the current work coordinate system.') }}">{{ _("0 All") }}</button>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Tip: zero only after the tool is above the board. Keep the same origin for both sides of a double-sided board.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Current work coordinate system: the active G54-G59 setup defines where your board origin is. G0/G1 positions are then relative to that origin, not to the machine home.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Advanced: if you re-zero after a tool change, document the reference point so later layers still line up.") }}
                    </div>
                </div>

                <!-- Probing -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-search-plus"></i> {{ _("Probe") }}</h4>
                    <div class="grblpcb-btn-wrap">
                        <button class="btn btn-small btn-info" data-bind="click: probeZ, enable: manualIdle">Z</button>
                        <button class="btn btn-small" data-bind="click: probeX, enable: manualIdle">X</button>
                        <button class="btn btn-small" data-bind="click: probeY, enable: manualIdle">Y</button>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Tip: probe only on a clean conductive surface and watch the first probe carefully for unexpected contact.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("For repeatability checks, probe the same point several times and compare the spread before trusting the result.") }}
                    </div>
                </div>

                <!-- Spindle -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-sync-alt"></i> {{ _("Spindle") }}</h4>
                    <div class="grblpcb-btn-wrap">
                        <button class="btn btn-small btn-success" data-bind="click: spindleOn, enable: manualIdle">{{ _("On") }}</button>
                        <button class="btn btn-small btn-danger" data-bind="click: spindleOff">{{ _("Off") }}</button>
                        <input type="number" class="input-mini grblpcb-w-55" data-bind="value: spindleSpeedTarget">
                        <button class="btn btn-mini" data-bind="click: setSpindleSpeed, enable: manualIdle">{{ _("Set") }}</button>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Tip: start conservative on a new tool or board material, then increase after a successful test cut.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("If spindle noise or burrs increase, reduce feed or speed before changing the toolpath itself.") }}
                    </div>
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- PCB Project Tab Content                                    -->
            <!-- ========================================================== -->
            <div data-bind="visible: activeSubTab() === 'pcb'">
                <!-- Project Header -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-folder-open"></i> {{ _("Project") }}</h4>
                    <div class="grblpcb-mb-6">
                        <input type="text" class="input-small grblpcb-input-block" data-bind="value: projectName" placeholder="{{ _('Project name') }}">
                    </div>
                    <div class="grblpcb-btn-wrap">
                        <button class="btn btn-small btn-primary" data-bind="click: newProject">
                            <i class="fas fa-plus"></i> {{ _("New") }}
                        </button>
                        <button class="btn btn-small" data-bind="click: toggleProjectBrowser">
                            <i class="fas fa-folder"></i> {{ _("Browse") }}
                            <span class="badge grblpcb-text-xs" data-bind="text: savedProjects().length, visible: savedProjects().length > 0"></span>
                        </button>
                    </div>
                    <!-- Active project info -->
                    <div data-bind="visible: hasProject" class="grblpcb-mt-6">
                        <span class="label label-success grblpcb-text-sm">
                            <i class="fas fa-check"></i>
                            <span data-bind="text: project() ? project().name : ''"></span>
                        </span>
                        <span data-bind="visible: boardWidth() > 0" class="grblpcb-text-sm grblpcb-text-soft">
                            <span data-bind="text: boardWidth().toFixed(1)"></span>&times;<span data-bind="text: boardHeight().toFixed(1)"></span>mm
                        </span>
                    </div>
                </div>

                <!-- Saved Projects Browser -->
                <div data-bind="visible: showProjectBrowser" class="grblpcb-compact-section grblpcb-project-browser-compact">
                    <h4><i class="fas fa-list"></i> {{ _("Saved Projects") }}</h4>
                    <div data-bind="visible: savedProjects().length === 0">
                        <small class="grblpcb-text-muted">{{ _("No saved projects.") }}</small>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Saved projects keep imported layers, generated toolpaths, and alignment settings together.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Tip: saved projects are ideal for repeat jobs because they preserve the layer combination and the last-used alignment choices.") }}
                    </div>
                    <div data-bind="foreach: savedProjects" class="grblpcb-project-list-scroll">
                        <div class="grblpcb-project-item" data-bind="click: $parent.loadProject, css: { active: $parent.project() && $parent.project().id === $data.id }">
                            <div class="grblpcb-flex-between">
                                <strong data-bind="text: $data.name" class="grblpcb-text-base"></strong>
                                <button class="btn btn-mini btn-danger" title="{{ _('Delete') }}"
                                        data-bind="click: function(data, event) { event.stopPropagation(); $parent.deleteProject(data); }">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            <small class="grblpcb-text-muted">
                                <span data-bind="visible: $data.board_width > 0, text: $data.board_width.toFixed(1) + '×' + $data.board_height.toFixed(1) + 'mm'"></span>
                                <span data-bind="text: $parent.projectSummaryText($data)"></span>
                            </small>
                        </div>
                    </div>
                </div>

                <!-- File Upload -->
                <div class="grblpcb-compact-section" data-bind="visible: hasProject">
                    <h4><i class="fas fa-upload"></i> {{ _("Import Files") }}</h4>
                    <input type="file" id="grblpcb-file-input" multiple
                           accept=".gbr,.gtl,.gbl,.gto,.gbo,.gts,.gbs,.gm1,.gko,.drl,.exc,.xln"
                           data-bind="event: { change: uploadFiles }"
                           class="grblpcb-file-input">
                    <div data-bind="visible: uploadMessage" class="grblpcb-mt-4">
                        <small data-bind="text: uploadMessage,
                            style: { color: uploadMessageIsError() ? '#b94a48' : '#555' }"
                            class="grblpcb-word-break"></small>
                    </div>
                </div>

                <!-- Imported Layers -->
                <div class="grblpcb-compact-section" data-bind="visible: projectLayers().length > 0">
                    <h4><i class="fas fa-layer-group"></i> {{ _("Layers") }}</h4>
                    <div data-bind="foreach: projectLayers" class="grblpcb-layer-list">
                        <div class="grblpcb-layer-item">
                            <label class="checkbox grblpcb-mb-0">
                                <input type="checkbox" checked data-bind="checked: $parent.wsLayerVisible($data.layer_type),
                                    click: function() { $parent.toggleGerberLayer($data.layer_type); return true; }">
                                <span class="label grblpcb-text-xs" data-bind="text: GrblPcbLabels.layer(layer_type), css: {
                                    'label-success': layer_type === 'top_copper',
                                    'label-info': layer_type === 'bottom_copper',
                                    'label-warning': layer_type === 'drill',
                                    'label-important': layer_type === 'outline'
                                }"></span>
                            </label>
                            <small class="grblpcb-text-muted" data-bind="text: width.toFixed(1) + '×' + height.toFixed(1)"></small>
                            <button class="btn btn-mini grblpcb-layer-delete" title="{{ _('Remove layer') }}"
                                    data-bind="click: function() { $parent.removeLayer(layer_type); }">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Board Transform -->
                <div class="grblpcb-compact-section" data-bind="visible: projectLayers().length > 0">
                    <h4><i class="fas fa-sync-alt"></i> {{ _("Transform") }}</h4>
                    <div class="grblpcb-transform-row">
                        <div class="btn-group">
                            <button class="btn btn-mini" title="{{ _('Rotate 90° CCW') }}"
                                    data-bind="click: function() { rotateProject(90); }, enable: !busyGenerating()">
                                <i class="fas fa-undo"></i> 90°
                            </button>
                            <button class="btn btn-mini" title="{{ _('Rotate 180°') }}"
                                    data-bind="click: function() { rotateProject(180); }, enable: !busyGenerating()">
                                <i class="fas fa-sync"></i> 180°
                            </button>
                            <button class="btn btn-mini" title="{{ _('Rotate 90° CW') }}"
                                    data-bind="click: function() { rotateProject(-90); }, enable: !busyGenerating()">
                                <i class="fas fa-redo"></i> 90°
                            </button>
                        </div>
                        <div class="input-append grblpcb-ml-6">
                            <input type="number" step="1" class="input-mini grblpcb-rotation-input" data-bind="value: customRotationAngle"
                                   title="{{ _('Custom angle (CCW)') }}">
                            <span class="add-on grblpcb-rotation-addon">°</span>
                        </div>
                        <button class="btn btn-mini" title="{{ _('Rotate by custom angle') }}"
                                data-bind="click: function() { rotateProject(parseFloat(customRotationAngle())); }, enable: !busyGenerating()">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Tip: keep the board orientation consistent. If you rotate here, all imported layers and drill positions rotate together.") }}
                    </div>
                </div>

                <!-- Generate G-code -->
                <div class="grblpcb-compact-section" data-bind="visible: hasProject">
                    <h4 class="grblpcb-collapsible" data-bind="click: function() { showGenParams(!showGenParams()); }">
                        <i class="fas fa-cogs"></i> {{ _("Generate G-code") }}
                        <i class="fas grblpcb-collapse-icon" data-bind="css: {'fa-chevron-down': showGenParams(), 'fa-chevron-right': !showGenParams()}"></i>
                    </h4>

                    <!-- Collapsible generation parameters -->
                    <div data-bind="visible: showGenParams" class="grblpcb-gen-params">

                        <!-- ── Isolation Milling ── -->
                        <div class="grblpcb-param-group">
                            <h5 class="grblpcb-param-heading"><i class="fas fa-route"></i> {{ _("Isolation Milling") }}</h5>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Tool ⌀") }}</label>
                                <div class="input-append"><input type="number" step="0.01" class="input-mini grblpcb-w-50" data-bind="value: genToolDiameter" title="{{ _('V-bit tip diameter') }}"><span class="add-on">mm</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("V-angle") }}</label>
                                <div class="input-append"><input type="number" step="1" class="input-mini grblpcb-w-45" data-bind="value: genToolAngle" title="{{ _('V-bit included angle') }}"><span class="add-on">°</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Cut depth") }}</label>
                                <div class="input-append"><input type="number" step="0.01" class="input-mini grblpcb-w-50" data-bind="value: genCutDepth" title="{{ _('Total isolation cut depth') }}"><span class="add-on">mm</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Depth/pass") }}</label>
                                <div class="input-append"><input type="number" step="0.01" min="0" class="input-mini grblpcb-w-50" data-bind="value: genDepthPerPass" title="{{ _('Depth per Z-pass (0 = full depth in one pass)') }}"><span class="add-on">mm</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Passes") }}</label>
                                <input type="number" min="1" class="input-mini grblpcb-w-40" data-bind="value: genPasses, disable: genClearGaps" title="{{ _('Number of lateral isolation passes') }}">
                                <label class="grblpcb-ml-4">{{ _("Overlap") }}</label>
                                <div class="input-append"><input type="number" step="5" min="10" max="90" class="input-mini grblpcb-w-40" data-bind="value: genPassOverlap" title="{{ _('Share of the trench width that neighbouring passes overlap (10 to 90 percent)') }}"><span class="add-on">%</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label class="checkbox" title="{{ _('Automatically add passes until all gaps between copper features are fully cleared') }}">
                                    <input type="checkbox" data-bind="checked: genClearGaps"> {{ _("Clear all gaps") }}
                                </label>
                            </div>
                        </div>

                        <!-- ── Speeds & Heights ── -->
                        <div class="grblpcb-param-group">
                            <h5 class="grblpcb-param-heading"><i class="fas fa-tachometer-alt"></i> {{ _("Speeds & Heights") }}</h5>
                            <div class="grblpcb-param-row">
