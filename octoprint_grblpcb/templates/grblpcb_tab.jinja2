                                <label>{{ _("Board") }}</label>
                                <div class="input-append"><input type="number" step="0.1" class="input-mini grblpcb-w-45" data-bind="value: genBoardThickness" title="{{ _('PCB board thickness') }}"><span class="add-on">mm</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Breakthrough") }}</label>
