                                <label>{{ _("Tool ⌀") }}</label>
                                <div class="input-append grblpcb-mb-0">
                                    <input type="number" step="0.1" min="0.1" class="input-mini grblpcb-w-45" data-bind="value: genOutlineDiameter">
                                    <span class="add-on">mm</span>
                                </div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Step down") }}</label>
                                <div class="input-append"><input type="number" step="0.1" min="0.1" class="input-mini grblpcb-w-45" data-bind="value: genOutlineStepDown" title="{{ _('Depth per outline pass') }}"><span class="add-on">mm</span></div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Tabs") }}</label>
                                <input type="number" min="0" class="input-mini grblpcb-w-35" data-bind="value: genNumTabs">
                                <label class="grblpcb-ml-4">{{ _("W") }}</label>
                                <input type="number" step="0.5" class="input-mini grblpcb-w-35" data-bind="value: genTabWidth">
                                <label class="grblpcb-ml-2">{{ _("H") }}</label>
                                <input type="number" step="0.1" class="input-mini grblpcb-w-35" data-bind="value: genTabHeight">
                            </div>
                        </div>

                        <!-- ── UV Mask Exposure ── -->
                        <div class="grblpcb-param-group">
                            <h5 class="grblpcb-param-heading"><i class="fas fa-sun"></i> {{ _("Solder Mask (UV)") }}</h5>
                            <div class="grblpcb-param-row">
                                <label>{{ _("LED Offset") }}</label>
                                <label class="grblpcb-ml-2">X</label>
                                <div class="input-append grblpcb-mb-0">
                                    <input type="number" step="0.1" class="input-mini grblpcb-w-45" data-bind="value: genUvOffsetX">
                                    <span class="add-on">mm</span>
                                </div>
                                <label class="grblpcb-ml-2">Y</label>
                                <div class="input-append grblpcb-mb-0">
                                    <input type="number" step="0.1" class="input-mini grblpcb-w-45" data-bind="value: genUvOffsetY">
                                    <span class="add-on">mm</span>
                                </div>
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Spot ⌀") }}</label>
                                <div class="input-append grblpcb-mb-0">
                                    <input type="number" step="0.1" min="0.1" class="input-mini grblpcb-w-45" data-bind="value: genUvSpotSize">
                                    <span class="add-on">mm</span>
                                </div>
                                <label class="grblpcb-ml-4">{{ _("Power") }}</label>
                                <input type="number" min="0" max="255" class="input-mini grblpcb-w-35" data-bind="value: genUvPower">
                            </div>
                            <div class="grblpcb-param-row">
                                <label>{{ _("Speed") }}</label>
                                <div class="input-append grblpcb-mb-0">
                                    <input type="number" step="10" min="1" class="input-mini grblpcb-w-45" data-bind="value: genUvExposeSpeed">
                                    <span class="add-on">mm/min</span>
                                </div>
                                <label class="grblpcb-ml-4">Z</label>
                                <div class="input-append grblpcb-mb-0">
                                    <input type="number" step="0.5" class="input-mini grblpcb-w-45" data-bind="value: genUvExposeZ">
                                    <span class="add-on">mm</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-small btn-block grblpcb-gen-btn btn-primary"
                            data-bind="click: function() { generateIsolation('top_copper'); }, visible: hasTopCopperLayer, enable: !busyGenerating()">
                        <i class="fas" data-bind="css: {'fa-route': !busyGenerating(), 'fa-spinner fa-spin': busyGenerating()}"></i> {{ _("Isolation (Top)") }}
                    </button>
                    <button class="btn btn-small btn-block grblpcb-gen-btn"
                            data-bind="click: function() { generateIsolation('bottom_copper'); }, visible: hasBottomCopperLayer, enable: !busyGenerating()">
                        <i class="fas" data-bind="css: {'fa-route': !busyGenerating(), 'fa-spinner fa-spin': busyGenerating()}"></i> {{ _("Isolation (Bottom)") }}
                    </button>
                    <button class="btn btn-small btn-block grblpcb-gen-btn"
                            data-bind="click: generateDrill, visible: hasDrillLayer, enable: hasDrillHoles() && !busyGenerating(),
                                       attr: { title: drillButtonTitle }">
                        <i class="fas" data-bind="css: {'fa-circle': !busyGenerating(), 'fa-spinner fa-spin': busyGenerating()}"></i> {{ _("Drilling") }}
                        <small class="grblpcb-opacity-muted" data-bind="text: hasDrillHoles() ? drillHoleCountText() : ''"></small>
                    </button>
                    <button class="btn btn-small btn-block grblpcb-gen-btn"
                            data-bind="click: generateOutline, visible: hasProject, enable: !busyGenerating()">
                        <i class="fas" data-bind="css: {'fa-vector-square': !busyGenerating(), 'fa-spinner fa-spin': busyGenerating()}"></i> {{ _("Outline Cut") }}
                    </button>
                    <button class="btn btn-small btn-block grblpcb-gen-btn"
                            data-bind="click: function() { generateMaskExpose('top_mask'); }, visible: hasTopMaskLayer, enable: !busyGenerating(), attr: { title: maskButtonTitle }">
                        <i class="fas" data-bind="css: {'fa-sun': !busyGenerating(), 'fa-spinner fa-spin': busyGenerating()}"></i> {{ _("Mask Expose (Top)") }}
                    </button>
                    <button class="btn btn-small btn-block grblpcb-gen-btn"
                            data-bind="click: function() { generateMaskExpose('bottom_mask'); }, visible: hasBottomMaskLayer, enable: !busyGenerating(), attr: { title: maskButtonTitle }">
                        <i class="fas" data-bind="css: {'fa-sun': !busyGenerating(), 'fa-spinner fa-spin': busyGenerating()}"></i> {{ _("Mask Expose (Bottom)") }}
                    </button>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes" title="{{ _('Interpretation: G0 = rapid move, G1 = feed move, Z changes are tool height values, and the active WCS defines the board origin.') }}">
                        {{ _("Tip: generate and preview one operation at a time first, then combine only when the alignment and tool settings look correct.") }}
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes" title="{{ _('G-code is just a toolpath program. The important pieces are the active WCS, feed values, spindle speed, and the cut depth per layer.') }}">
                        {{ _("Advanced: compare the preview of routing and drilling separately before you run a combined job on the machine.") }}
                    </div>
                    <div class="grblpcb-guide-inline" data-bind="visible: showHelpNotes" title="{{ _('Quick meaning: G0 = move quickly, G1 = cut/move at feed speed, G54-G59 = the chosen board origin, Z = vertical position.') }}">
                        <strong>{{ _("G-code quick guide:") }}</strong> {{ _("G0 is a fast travel move, G1 is a cutting or feed move, and the current WCS decides where the board coordinate system starts.") }}
                    </div>
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- Autolevel Tab Content                                      -->
            <!-- ========================================================== -->
            <div data-bind="visible: activeSubTab() === 'autolevel'">
                <div class="grblpcb-compact-section grblpcb-guide-inline">
                    <strong>{{ _("Before probing:") }}</strong>
                    <ol class="grblpcb-guide-steps">
                        <li>{{ _("Clamp the board and put the engraving bit into the spindle.") }}</li>
                        <li>{{ _("Connect the probe: one clip on the copper, one on the bit. Test it by touching them together; the status must show the probe pin.") }}</li>
                        <li>{{ _("Jog to the lower left corner of the board and set X and Y to zero.") }}</li>
                        <li>{{ _("Probe Z on the copper and set Z to zero (Machine tab).") }}</li>
                    </ol>
                    {{ _("The run touches the copper at every grid point and stores the heights. Leveled G-code then follows the real surface, so the cut is equally deep everywhere.") }}
                </div>

                <!-- Probe Grid Setup -->
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-th"></i> {{ _("Probe Grid") }}</h4>
                    <div class="grblpcb-grid-inputs">
                        <label>X: <input type="number" class="input-mini grblpcb-w-45" min="2" max="20"
                                   data-bind="value: autolevelGridX"></label>
                        <label>Y: <input type="number" class="input-mini grblpcb-w-45" min="2" max="20"
                                   data-bind="value: autolevelGridY"></label>
                        <label>{{ _("Margin:") }} <input type="number" class="input-mini grblpcb-w-45" step="0.5" min="0"
                                   data-bind="value: autolevelMargin"> mm</label>
                    </div>
                    <button class="btn btn-primary btn-small btn-block" data-bind="click: setupAutolevel, enable: canSetupGrid">
                        <i class="fas fa-th"></i> {{ _("Generate Grid") }}
                    </button>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("For beginners: start with a smaller grid and larger margin. For experienced users: tighten the grid when you need more precise compensation.") }}
                    </div>
                    <div data-bind="visible: hasHeightmap" class="grblpcb-mt-8">
                        <div class="grblpcb-autolevel-actions">
                            <button class="btn btn-success btn-small grblpcb-flex-1" data-bind="click: startAutolevel, enable: canAutolevel, visible: !autolevelRunning()">
                                <i class="fas fa-play"></i> <span data-bind="text: probeButtonLabel"></span>
                            </button>
                            <button class="btn btn-danger btn-small grblpcb-flex-1" data-bind="click: stopAutolevel, visible: autolevelRunning">
                                <i class="fas fa-stop"></i> {{ _("Stop") }}
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Progress -->
                <div class="grblpcb-compact-section" data-bind="visible: autolevelStatus">
                    <h4><i class="fas fa-chart-line"></i> {{ _("Progress") }}</h4>
                    <div data-bind="visible: autolevelStatus">
                        <small data-bind="text: autolevelStatus" class="grblpcb-word-break"></small>
                    </div>
                    <div class="grblpcb-section-note" data-bind="visible: showHelpNotes">
                        {{ _("Autolevel can take a while. Do not move the machine manually while probing is active.") }}
                    </div>
                    <div data-bind="visible: autolevelProgress() > 0" class="grblpcb-mt-5">
                        <div class="progress grblpcb-progress-compact">
                            <div class="bar" data-bind="style: { width: autolevelProgress() + '%' }, css: {
                                'bar-success': autolevelProgress() >= 100,
                                'bar-info': autolevelProgress() < 100
                            }"></div>
                        </div>
                    </div>
                </div>

                <!-- Probe Data Table (collapsible) -->
                <div class="grblpcb-compact-section" data-bind="visible: heightmapPoints().length > 0">
                    <h4 class="grblpcb-collapsible" data-bind="click: toggleProbeTable">
                        <i class="fas" data-bind="css: { 'fa-chevron-down': showProbeTable(), 'fa-chevron-right': !showProbeTable() }"></i>
                        {{ _("Probe Data") }}
                        <small data-bind="text: heightmapPointsText"></small>
                    </h4>
                    <div data-bind="visible: showProbeTable" class="grblpcb-probe-data-scroll">
                        <table class="table table-condensed table-bordered grblpcb-probe-table">
                            <thead>
                                <tr><th>#</th><th>X</th><th>Y</th><th>Z</th></tr>
                            </thead>
                            <tbody data-bind="foreach: heightmapPoints">
                                <tr data-bind="css: { success: probed, warning: !probed }">
                                    <td data-bind="text: $index() + 1"></td>
                                    <td data-bind="text: x.toFixed(2)"></td>
                                    <td data-bind="text: y.toFixed(2)"></td>
                                    <td data-bind="text: probed ? z.toFixed(4) : '—'"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- Operations Tab Content                                     -->
            <!-- ========================================================== -->
            <div data-bind="visible: activeSubTab() === 'operations'">
                <div class="grblpcb-compact-section">
                    <h4><i class="fas fa-list"></i> {{ _("Operations") }}</h4>
                    <div data-bind="visible: projectOperations().length === 0">
                        <small class="grblpcb-text-muted">{{ _("No operations yet. Generate the toolpaths first:") }}</small>
                        <button class="btn btn-small" data-bind="click: function() { switchTab('pcb'); }"><i class="fas fa-arrow-left"></i> {{ _("Go to the Board tab") }}</button>
                    </div>

                    <!-- Execution Progress Panel -->
                    <div class="grblpcb-execution-panel" data-bind="visible: executionActive() || executionStatus()">
                        <div data-bind="visible: executionActive">
                            <div class="progress">
                                <div class="bar bar-success" data-bind="style: { width: executionProgress() + '%' }"></div>
                            </div>
                        </div>
                        <small data-bind="text: executionStatus" class="grblpcb-word-break"></small>
                        <div class="grblpcb-btn-wrap grblpcb-mt-4" data-bind="visible: executionActive">
                            <button class="btn btn-mini btn-danger" data-bind="click: stopExecution">
                                <i class="fas fa-stop"></i> {{ _("Stop") }}
                            </button>
                            <button class="btn btn-mini btn-warning" data-bind="click: confirmToolChange">
                                <i class="fas fa-check"></i> {{ _("Confirm Tool Change") }}
                            </button>
                        </div>

                        <!-- Real-time Override Controls -->
                        <div data-bind="visible: executionActive" class="grblpcb-override-section">
                            <h5 class="grblpcb-override-title"><i class="fas fa-sliders-h"></i> {{ _("Real-time Overrides") }}</h5>

                            <!-- Feed Override -->
                            <div class="grblpcb-override-row">
                                <span class="grblpcb-override-label">{{ _("Feed") }}</span>
                                <span class="label label-info grblpcb-override-value" data-bind="text: feedOverride() + '%'"></span>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: feedMinus10" title="-10%">-10</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: feedMinus1" title="-1%">-1</button>
                                <button class="btn btn-mini btn-success grblpcb-override-btn" data-bind="click: feedReset" title="Reset to 100%">100%</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: feedPlus1" title="+1%">+1</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: feedPlus10" title="+10%">+10</button>
                            </div>

                            <!-- Rapid Override -->
                            <div class="grblpcb-override-row">
                                <span class="grblpcb-override-label">{{ _("Rapid") }}</span>
                                <span class="label label-info grblpcb-override-value" data-bind="text: rapidOverride() + '%'"></span>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: rapidQuarter" title="25%">25%</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: rapidHalf" title="50%">50%</button>
                                <button class="btn btn-mini btn-success grblpcb-override-btn" data-bind="click: rapidFull" title="100%">100%</button>
                            </div>

                            <!-- Spindle Override -->
                            <div class="grblpcb-override-row">
                                <span class="grblpcb-override-label">{{ _("Spindle") }}</span>
                                <span class="label label-info grblpcb-override-value" data-bind="text: spindleOverride() + '%'"></span>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: spindleMinus10" title="-10%">-10</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: spindleMinus1" title="-1%">-1</button>
                                <button class="btn btn-mini btn-success grblpcb-override-btn" data-bind="click: spindleReset" title="Reset to 100%">100%</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: spindlePlus1" title="+1%">+1</button>
                                <button class="btn btn-mini grblpcb-override-btn" data-bind="click: spindlePlus10" title="+10%">+10</button>
                            </div>
                        </div>
                    </div>
                    <div data-bind="foreach: projectOperations" class="grblpcb-operations-list">
                        <div class="grblpcb-op-item">
                            <div class="grblpcb-flex-between">
                                <strong class="grblpcb-op-name" data-bind="text: GrblPcbLabels.operation($data)"></strong>
                                <div>
                                    <span class="label grblpcb-text-xs" data-bind="visible: !has_gcode">{{ _("No G-code") }}</span>
                                    <span class="label label-info grblpcb-text-xs" data-bind="visible: has_aligned_gcode"
                                          title="{{ _('The double-sided alignment is applied to this operation.') }}">{{ _("Aligned") }}</span>
                                    <span class="label label-success grblpcb-text-xs" data-bind="visible: has_leveled_gcode"
                                          title="{{ _('The leveled G-code is sent: the height map is applied.') }}">{{ _("Leveled") }}</span>
                                    <span class="label grblpcb-text-xs" data-bind="visible: has_gcode && !has_leveled_gcode && $parent.hasHeightmap()"
                                          title="{{ _('The G-code is sent without height correction.') }}">{{ _("Not leveled") }}</span>
                                </div>
                            </div>
                            <!-- Operation details -->
                            <div class="grblpcb-op-details">
                                <!-- ko if: tool_diameter -->
                                <span>{{ _("Tool:") }} <span data-bind="text: tool_diameter"></span>mm</span>
                                <!-- /ko -->
                                <!-- ko if: cut_depth > 0 -->
                                <span>{{ _("Depth:") }} <span data-bind="text: cut_depth"></span>mm</span>
                                <!-- /ko -->
                                <!-- ko if: feed_rate -->
                                <span>F<span data-bind="text: feed_rate"></span></span>
                                <!-- /ko -->
                                <!-- ko if: gcode_lines -->
                                <span data-bind="text: $parent.gcodeLinesText(gcode_lines)"></span>
                                <!-- /ko -->
                            </div>
                            <div class="grblpcb-op-actions">
                                <button class="btn btn-small btn-success"
                                        data-bind="click: function() { $parent.sendToCnc($index()); }, enable: has_gcode && $parent.isGrblConnector() && !$parent.executionActive()">
                                    <i class="fas fa-play"></i> {{ _("Send") }}
                                </button>
                                <span class="grblpcb-op-secondary">
                                    <button class="btn btn-mini" title="{{ _('Apply Autolevel') }}"
                                            data-bind="click: function() { $parent.applyAutolevel($index()); }, enable: has_gcode && $parent.hasHeightmap()">
                                        <i class="fas fa-level-up-alt"></i>
                                    </button>
                                    <button class="btn btn-mini" title="{{ _('Mirror for the back side') }}"
                                            data-bind="click: function() { $parent.mirrorGcode($index()); }, enable: has_gcode, visible: can_mirror">
                                        <i class="fas fa-arrows-alt-h"></i>
                                    </button>
                                    <button class="btn btn-mini" title="{{ _('Download') }}"
                                            data-bind="click: function() { $parent.downloadGcode($index()); }, enable: has_gcode">
                                        <i class="fas fa-download"></i>
                                    </button>
                                    <button class="btn btn-mini" title="{{ _('Move Up') }}"
                                            data-bind="click: function() { $parent.moveOperationUp($index()); }, enable: $index() > 0">
                                        <i class="fas fa-arrow-up"></i>
                                    </button>
                                    <button class="btn btn-mini" title="{{ _('Move Down') }}"
                                            data-bind="click: function() { $parent.moveOperationDown($index()); }, enable: $index() < $parent.projectOperations().length - 1">
                                        <i class="fas fa-arrow-down"></i>
                                    </button>
                                    <button class="btn btn-mini" title="{{ _('Delete') }}"
                                            data-bind="click: function() { $parent.deleteOperation($index()); }">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- Double-Sided Alignment                                     -->
            <!-- ========================================================== -->
            <div data-bind="visible: activeSubTab() === 'operations'">
                <div class="grblpcb-compact-section" data-bind="visible: hasProject">
                    <h4><i class="fas fa-sync-alt"></i> {{ _("Double-Sided Alignment") }}</h4>

                    <!-- Step 1: Set alignment holes -->
                    <div class="grblpcb-mb-6">
                        <button class="btn btn-mini btn-info"
                                data-bind="click: setAlignmentHolesFromDrills, enable: projectDrills().length > 0"
                                title="{{ _('Automatically pick the 2 farthest-apart drill holes as alignment references') }}">
                            <i class="fas fa-crosshairs"></i> {{ _("Auto-Select Alignment Holes") }}
                        </button>
                        <small class="muted grblpcb-text-muted">
                            {{ _("Uses the two drill holes farthest apart") }}
                        </small>
                    </div>

                    <!-- Show selected holes -->
                    <!-- ko if: alignmentHoles().length > 0 -->
                    <div class="grblpcb-align-data">
                        <strong class="grblpcb-align-heading">{{ _("Alignment Holes:") }}</strong>
                        <!-- ko foreach: alignmentHoles -->
                        <div class="grblpcb-align-hole-row">
                            <i class="fas" data-bind="css: { 'fa-check text-success': probed, 'fa-circle text-muted': !probed }"></i>
                            <span data-bind="text: $parent.alignmentHoleText($data, $index())"></span>
                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->

                    <!-- Step 2: Probe alignment holes -->
                    <div class="grblpcb-mb-6">
                        <!-- ko ifnot: alignmentProbing -->
                        <button class="btn btn-mini btn-warning"
                                data-bind="click: probeAlignment, enable: alignmentHoles().length >= 2 && isGrblConnector()"
                                title="{{ _('Probe each alignment hole to find its actual XY center') }}">
                            <i class="fas fa-bullseye"></i> {{ _("Probe Alignment Holes") }}
                        </button>
                        <!-- /ko -->
                        <!-- ko if: alignmentProbing -->
                        <button class="btn btn-mini btn-danger"
                                data-bind="click: stopAlignmentProbe">
                            <i class="fas fa-stop"></i> {{ _("Stop Probing") }}
                        </button>
                        <!-- /ko -->
                    </div>

                    <!-- Step 3: Compute + Apply -->
                    <!-- ko if: hasAlignmentTransform -->
                    <div class="grblpcb-align-transform">
                        <strong>{{ _("Transform:") }}</strong>
                        <span data-bind="text: alignmentTransformText"></span>
                    </div>
                    <div class="grblpcb-mb-6">
                        <button class="btn btn-mini btn-success"
                                data-bind="click: applyAlignmentToAll"
                                title="{{ _('Apply alignment compensation to all mirrored operations') }}">
                            <i class="fas fa-check-double"></i> {{ _("Apply to All Mirrored Ops") }}
                        </button>
                    </div>
                    <!-- /ko -->

                    <!-- Status line -->
                    <!-- ko if: alignmentStatus -->
                    <div class="grblpcb-align-status"
                         data-bind="text: alignmentStatus"></div>
                    <!-- /ko -->

                    <div class="grblpcb-mt-4">
                        <button class="btn btn-mini"
                                data-bind="click: clearAlignment, enable: alignmentHoles().length > 0"
                                title="{{ _('Clear all alignment data') }}">
                            <i class="fas fa-eraser"></i> {{ _("Clear") }}
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Main Canvas Workspace (always visible) -->
        <div class="grblpcb-workspace-canvas-container">
            <canvas id="grblpcb-workspace-canvas"></canvas>

            <button class="btn btn-small grblpcb-wide-toggle" data-bind="click: toggleWideView, css: { active: wideView }"
                    title="{{ _('Wide view: use the whole page width for the workspace and hide the OctoPrint side panels') }}">
                <i class="fas" data-bind="css: { 'fa-expand-alt': !wideView(), 'fa-compress-alt': wideView() }"></i>
            </button>

            <button class="btn btn-small grblpcb-sidebar-toggle" data-bind="click: toggleWorkspaceSidebar"
                    title="{{ _('Show or hide the control panel') }}">
                <i class="fas" data-bind="css: { 'fa-chevron-left': workspaceSidebarOpen(), 'fa-chevron-right': !workspaceSidebarOpen() }"></i>
            </button>

            <!-- View toolbar on the canvas -->
            <div class="grblpcb-view-toolbar">
                <div class="btn-group">
                    <button class="btn btn-small" data-bind="click: function() { setWorkspaceView('2d'); }, css: { active: workspaceViewMode() === '2d' }">2D</button>
                    <button class="btn btn-small" data-bind="click: function() { setWorkspaceView('3d'); }, css: { active: workspaceViewMode() === '3d' }">3D</button>
                </div>
                <button class="btn btn-small" data-bind="click: fitWorkspaceView" title="{{ _('Fit View') }}">
                    <i class="fas fa-expand"></i>
                </button>
                <button class="btn btn-small" data-bind="click: function() { showViewOptions(!showViewOptions()); }, css: { active: showViewOptions }"
                        title="{{ _('Choose what the view shows') }}">
                    <i class="fas fa-layer-group"></i>
                </button>
                <div class="grblpcb-view-options" data-bind="visible: showViewOptions">
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowBoard"> {{ _("Board") }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowLayers"> {{ _("Gerber Layers") }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowCopper"> {{ _("Copper Fill") }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowProbeGrid"> {{ _("Probe Points") }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowHeightmap"> {{ _("Heat Map") }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowMachinePos"> {{ _("Machine Pos") }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: wsShowToolpaths"> {{ _("Toolpaths") }}</label>
                    <div class="grblpcb-view-toolpaths" data-bind="visible: wsShowToolpaths() && workspaceToolpathList().length > 0, foreach: workspaceToolpathList">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: $data.visible">
                            <span data-bind="text: $data.name, style: { color: $data.color }"></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="grblpcb-workspace-hint" data-bind="visible: !hasProject() && projectLayers().length === 0">
                <p><i class="fas fa-mouse-pointer"></i></p>
                <p>{{ _("Create or load a project in the Board tab to begin.") }}</p>
                <p class="grblpcb-text-base">{{ _("Scroll to zoom &middot; Drag to pan &middot; 3D: drag to rotate") }}</p>
            </div>
        </div>
    </div>
